{
  "_readme": [
    "Committed case table for src/pipeline/dates.js (05-implementation-plan.md Phase 0).",
    "Every record: {name, input, expected, expectedIssue}.",
    "input.raw is the cell value as read. input.rawKind selects a non-JSON type:",
    "  'date'      -> new Date(y, m-1, d[, H, M, S]) from input.raw as an array (LOCAL, as SheetJS builds it)",
    "  'undefined' -> undefined      (input.raw is ignored)",
    "  'invalidDate' -> new Date(NaN)",
    "  absent      -> input.raw used verbatim (string, number, null, boolean)",
    "input.column is a canonical column name from pipeline/columns.js.",
    "input.period defaults to '2026-02-28' - FEBRERO_2026, the last real run.",
    "input.config overrides config.js tunables for that case only.",
    "expected asserts every key it declares; expectedIssue is the FULL ordered list of",
    "issues the call must append - [] means the call must be silent.",
    "Reference serials were computed independently of dates.js as the day count from",
    "1899-12-30 (valid for every date after 1900-03-01)."
  ],

  "cases": [
    {
      "name": "text dd/mm/yyyy - the plan's worked example, 4 July not 7 April",
      "input": { "raw": "04/07/1994", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 34519, "ymd": { "y": 1994, "m": 7, "d": 4 }, "matchedFormat": "DD/MM/YYYY", "empty": false, "code": null },
      "expectedIssue": []
    },
    {
      "name": "text d/m/yyyy - 14/2/1989",
      "input": { "raw": "14/2/1989", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 32553, "ymd": { "y": 1989, "m": 2, "d": 14 }, "matchedFormat": "D/M/YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text d/m/yyyy - 3/5/1965 is 3 May, never 5 March",
      "input": { "raw": "3/5/1965", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 23865, "ymd": { "y": 1965, "m": 5, "d": 3 }, "matchedFormat": "D/M/YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text d/mm/yyyy - 3/10/1976",
      "input": { "raw": "3/10/1976", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 28036, "ymd": { "y": 1976, "m": 10, "d": 3 }, "matchedFormat": "D/M/YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text dd/mm/yyyy - 01/12/2002",
      "input": { "raw": "01/12/2002", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 37591, "ymd": { "y": 2002, "m": 12, "d": 1 }, "matchedFormat": "DD/MM/YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text dd-mm-yyyy",
      "input": { "raw": "15-03-2020", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 43905, "ymd": { "y": 2020, "m": 3, "d": 15 }, "matchedFormat": "DD-MM-YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text dd.mm.yyyy - the template's own numFmt 164",
      "input": { "raw": "15.03.2020", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 43905, "ymd": { "y": 2020, "m": 3, "d": 15 }, "matchedFormat": "DD.MM.YYYY" },
      "expectedIssue": []
    },
    {
      "name": "ISO yyyy-mm-dd is unambiguous and accepted last, after every day-first candidate",
      "input": { "raw": "2020-03-15", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 43905, "ymd": { "y": 2020, "m": 3, "d": 15 }, "matchedFormat": "YYYY-MM-DD" },
      "expectedIssue": []
    },
    {
      "name": "untrimmed text - strict mode rejects padding, so trim comes first",
      "input": { "raw": "  04/07/1994 ", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 34519, "matchedFormat": "DD/MM/YYYY" },
      "expectedIssue": []
    },
    {
      "name": "text with an embedded newline is not a date",
      "input": { "raw": "04/07/1994\n", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": true, "serial": 34519, "matchedFormat": "DD/MM/YYYY" },
      "expectedIssue": []
    },

    {
      "name": "two-digit year in col O - 30/1/26 expands to 2026 (pivot 60)",
      "input": { "raw": "30/1/26", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 46052, "ymd": { "y": 2026, "m": 1, "d": 30 }, "matchedFormat": "D/M/YY" },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO", "detalle": { "ano": 2026, "pivote": 60, "retrocedidoUnSiglo": false } }]
    },
    {
      "name": "two-digit year in col O - 27/05/25",
      "input": { "raw": "27/05/25", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 45804, "matchedFormat": "DD/MM/YY" },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO" }]
    },
    {
      "name": "two-digit year in col M expands the same way",
      "input": { "raw": "27/05/25", "column": "FECHA CESE/BAJA" },
      "expected": { "ok": true, "serial": 45804 },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO" }]
    },
    {
      "name": "two-digit year in col F is REJECTED - 3/5/65 cannot be told from a typo (05 §8 Q1)",
      "input": { "raw": "3/5/65", "column": "FECHA NACIMIENTO" },
      "expected": { "ok": false, "empty": false, "serial": null, "code": "DATE_TWO_DIGIT_YEAR", "matchedFormat": "D/M/YY" },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "ERROR" }]
    },
    {
      "name": "policy is data-driven: REJECT_TWO_DIGIT_BIRTH_YEARS=false expands col F instead",
      "input": { "raw": "3/5/65", "column": "FECHA NACIMIENTO", "config": { "REJECT_TWO_DIGIT_BIRTH_YEARS": false } },
      "expected": { "ok": true, "serial": 23865, "ymd": { "y": 1965, "m": 5, "d": 3 } },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO" }]
    },
    {
      "name": "pivot boundary yy=60 -> 2060, then past-only pulls it back to 1960",
      "input": { "raw": "01/01/60", "column": "FECHA NACIMIENTO", "config": { "REJECT_TWO_DIGIT_BIRTH_YEARS": false } },
      "expected": { "ok": true, "serial": 21916, "ymd": { "y": 1960, "m": 1, "d": 1 } },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO", "detalle": { "ano": 1960, "retrocedidoUnSiglo": true } }]
    },
    {
      "name": "pivot boundary yy=61 -> 1961 directly, no shift",
      "input": { "raw": "01/01/61", "column": "FECHA NACIMIENTO", "config": { "REJECT_TWO_DIGIT_BIRTH_YEARS": false } },
      "expected": { "ok": true, "serial": 22282, "ymd": { "y": 1961, "m": 1, "d": 1 } },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO", "detalle": { "ano": 1961, "retrocedidoUnSiglo": false } }]
    },
    {
      "name": "past-only keeps a legitimate next-month start (period end + 1 month is plausible)",
      "input": { "raw": "15/3/26", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": true, "serial": 46096, "ymd": { "y": 2026, "m": 3, "d": 15 } },
      "expectedIssue": [{ "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO", "detalle": { "retrocedidoUnSiglo": false } }]
    },
    {
      "name": "past-only shifts a far-future two-digit year back a century, which then fails the range",
      "input": { "raw": "30/12/26", "column": "FECHA INICIO DE LABORES EN OBRA" },
      "expected": { "ok": false, "serial": null, "code": "DATE_IMPLAUSIBLE", "parsedYMD": { "y": 1926, "m": 12, "d": 30 } },
      "expectedIssue": [
        { "code": "DATE_TWO_DIGIT_YEAR", "severity": "INFO", "detalle": { "retrocedidoUnSiglo": true } },
        { "code": "DATE_IMPLAUSIBLE", "severity": "WARNING" }
      ]
    },

    {
